{# elt/templates/export_lion_for_tiling.jinja #}
-- Code definitions come from DCP's LION metadata:
-- https://s-media.nyc.gov/agencies/dcp/assets/files/pdf/data-tools/bytes/lion_metadata.pdf
COPY (
    WITH segments AS (
        SELECT
            array_to_string(list_transform(
                string_split(lower(trim(Street)), ' '),
                (w, i) -> CASE
                    WHEN regexp_matches(w, '^[0-9]+$') AND i < len(string_split(trim(Street), ' ')) THEN
                        w || CASE
                            WHEN w[-2:] IN ('11', '12', '13') THEN 'th'
                            WHEN w[-1:] = '1' THEN 'st'
                            WHEN w[-1:] = '2' THEN 'nd'
                            WHEN w[-1:] = '3' THEN 'rd'
                            ELSE 'th'
                        END
                    ELSE upper(w[1]) || w[2:]
                END
            ), ' ') AS name,
            -- RW_TYPE (Roadway Type): 1 Street, 2 Highway, 3 Bridge, 4 Tunnel,
            --   5 Boardwalk, 6 Path/Trail, 7 Step Street, 8 Driveway, 9 Ramp,
            --   10 Alley, 11 Unknown, 12 Non-Physical Street Segment, 13 U-Turn,
            --   14 Ferry Route. Stored space-padded to width 2, hence trim().
            -- Carto_Display_Level: DCP's flag for major roads at a given map
            --   scale. 10 City, 20 Borough, 30 Neighborhood, NULL unflagged.
            CASE
                WHEN trim(RW_TYPE) = '2' THEN 'highway'
                WHEN Carto_Display_Level IS NOT NULL THEN 'major_road'
                WHEN trim(RW_TYPE) IN ('5', '6', '7') THEN 'path'
                ELSE 'minor_road'
            END AS kind,
            CASE
                WHEN trim(RW_TYPE) = '2' THEN 11
                WHEN Carto_Display_Level = '10' THEN 12
                WHEN Carto_Display_Level IS NOT NULL THEN 13
                WHEN trim(RW_TYPE) IN ('5', '6', '7') THEN 16
                ELSE 15
            END AS min_zoom,
            -- CurveFlag: blank straight segment, I irregular curve (not a
            --   circular arc), L/R circular arc on the left/right of the directed
            --   From->To chord. ArcCenterX/Y and Radius (feet) are only set for
            --   L/R. Some curves come through as MULTICURVE, which DuckDB can't
            --   parse; L/R arcs are rebuilt through the arc midpoint and
            --   anything else falls back to the straight chord.
            coalesce(
                try(ST_GeomFromWKB(SHAPE)),
                CASE WHEN Radius > 0 THEN ST_MakeLine([
                    ST_Point(XFrom, YFrom),
                    ST_Point(
                        ArcCenterX + Radius * ((XFrom + XTo) / 2 - ArcCenterX)
                            / nullif(sqrt(((XFrom + XTo) / 2 - ArcCenterX) ** 2 + ((YFrom + YTo) / 2 - ArcCenterY) ** 2), 0),
                        ArcCenterY + Radius * ((YFrom + YTo) / 2 - ArcCenterY)
                            / nullif(sqrt(((XFrom + XTo) / 2 - ArcCenterX) ** 2 + ((YFrom + YTo) / 2 - ArcCenterY) ** 2), 0)
                    ),
                    ST_Point(XTo, YTo)
                ]) END,
                ST_MakeLine(ST_Point(XFrom, YFrom), ST_Point(XTo, YTo))
            ) AS geom
        FROM ST_Read('{{gdb_path}}', layer = 'lion', keep_wkb = true)
        WHERE
            -- FeatureTyp: 0 Street, 1 Railroad, 2 Water Edge/Shoreline,
            --   3 Census Block Boundary, 5 Paper Street (mapped but unbuilt),
            --   6 Private Street, 7 District Boundary, 8 Physical Non-Street
            --   Boundary, 9 Paper Street and Census/District Boundary, A Alley,
            --   W Path (non-vehicular, addressable), C CCO (privately owned
            --   street dedicated for public use), F Ferry Route.
            FeatureTyp IN ('0', '6', 'W')
            -- SegmentTyp: U Undivided Street, B Both (generic and roadbed; the
            --   center roadbed of a divided road with an odd number of roadbeds),
            --   G Generic (single-line stand-in for a divided street),
            --   R Roadbed (one carriageway of a divided street), C Connector
            --   (between roadbeds), E Entrance/Exit Ramp, F Faux (keeps
            --   connectivity to a generic segment), T Terminator (where a divided
            --   section ends), S Suppressed (hidden in the generic view).
            --   U/B/G is the generic view: one line per street, so divided
            --   streets are labeled once instead of once per roadbed.
            AND SegmentTyp IN ('U', 'B', 'G')
            AND trim(RW_TYPE) IN ('1', '2', '3', '5', '6', '7')
            -- Status: 1 Planned Private, 2 Constructed, 3 Paper,
            --   4 Under Construction, 5 Demapped, 9 Paper Street Coincident with
            --   Boundary.
            AND Status = '2'
            AND nullif(trim(Street), '') IS NOT NULL
    )
    SELECT
        name,
        kind,
        min_zoom,
        ST_Transform(
            ST_LineMerge(ST_Union_Agg(geom)),
            'EPSG:2263',
            'EPSG:4326',
            always_xy := true
        ) AS geometry
    FROM segments
    WHERE geom IS NOT NULL
    GROUP BY name, kind, min_zoom
) TO '{{out_path}}'
WITH (
    FORMAT GDAL,
    DRIVER 'FlatGeobuf',
    SRS 'EPSG:4326'
);
